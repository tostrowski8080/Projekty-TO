<Window x:Class="Lab4.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab4"
        mc:Ignorable="d"
        Title="PSP Kraków" Height="600" Width="1000">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#F0F0F0" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="1" Margin="0,0,0,10" Background="White">
                    <TextBlock Text="Legenda:" FontWeight="Bold" Margin="0,0,0,5"/>
                    <StackPanel Orientation="Horizontal" Margin="2">
                        <Rectangle Width="12" Height="12" Fill="DarkBlue" Margin="0,0,5,0"/>
                        <TextBlock Text="JRG"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="2">
                        <Ellipse Width="10" Height="10" Fill="OrangeRed" Margin="0,0,5,0"/>
                        <TextBlock Text="Pożar (PZ)"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="2">
                        <Ellipse Width="10" Height="10" Fill="Goldenrod" Margin="0,0,5,0"/>
                        <TextBlock Text="Miejscowe zdarzenie (MZ)"/>
                    </StackPanel>
                    <Separator Margin="2"/>
                    <StackPanel Orientation="Horizontal" Margin="2">
                        <Ellipse Width="8" Height="8" Fill="Blue" Margin="2,0,7,0"/>
                        <TextBlock Text="Wóz: Dojazd"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="2">
                        <Ellipse Width="8" Height="8" Fill="Yellow" Margin="2,0,7,0"/>
                        <TextBlock Text="Wóz: Czeka na resztę"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="2">
                        <Ellipse Width="8" Height="8" Fill="LightBlue" Margin="2,0,7,0"/>
                        <TextBlock Text="Wóz: Podejmowane działania"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="2">
                        <Ellipse Width="8" Height="8" Fill="Green" Margin="2,0,7,0"/>
                        <TextBlock Text="Wóz: Powrót"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Column="1" BorderBrush="Black" BorderThickness="1" Margin="5">
            <Canvas x:Name="MapCanvas" Background="#FFFAFAFA" ClipToBounds="True"/>
        </Border>
    </Grid>
</Window>